# Copy to .env.local and fill in values.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google Analytics (gtag.js – page tracking)
# Measurement ID from GA4 Admin > Data Streams (e.g. G-MG27CK781R)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-MG27CK781R

# GA4 Data API – for dashboard metrics (active users, total visits, visit location)
# Numeric Property ID from GA4 Admin > Property Settings
# GA4_PROPERTY_ID=123456789

# Service account: path to JSON key file, or paste JSON as string
# GOOGLE_APPLICATION_CREDENTIALS=./path/to/service-account.json
# GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account",...}
